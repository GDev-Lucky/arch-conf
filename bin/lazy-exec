#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$HOME/arch-setup"

as_root() {
    local reason=$1
    shift

    if (( EUID == 0 )); then
        "$@"
        return
    fi

    echo "Need root permission: $reason"

    local cmd
    printf -v cmd '%q ' "$@"

    su root -c "$cmd"
}

pkgs() {
    local -n result=$1
    shift

    local pkg
    result=()

    for pkg in "$@"; do
        if ! pacman -Qq -- "$pkg" &>/dev/null; then
            result+=("$pkg")
        fi
    done

    if (( ${#result[@]} )); then
        as_root "Install packages" \
            pacman -S --needed -- "${result[@]}"
    fi
}

remove_pkgs() {
    local -n packages=$1

    if (( ${#packages[@]} )); then
        as_root "Remove packages" \
            pacman -Rns -- "${packages[@]}"
    fi
}

ask_yes_no() {
    local prompt=$1 answer

    while true; do
        printf '%s [y/n]: ' "$prompt" >&2
        IFS= read -r answer </dev/tty || return 2

        case "${answer,,}" in
            y|yes) return 0 ;;
            n|no)  return 1 ;;
            *) echo "Please enter y or n." >&2 ;;
        esac
    done
}

ask_option() {
    local prompt=$1
    shift

    local -a options=("$@")
    local i answer count=${#options[@]}

    if (( count == 0 )); then
        echo "No options provided" >&2
        return 2
    fi

    printf '%s\n' "$prompt" >&2

    for ((i = 1; i <= count; i++)); do
        printf '  %d) %s\n' "$i" "${options[i-1]}" >&2
    done

    while true; do
        printf 'Select [1-%d]: ' "$count" >&2
        IFS= read -r answer </dev/tty || return 2

        if [[ $answer =~ ^[0-9]+$ ]]; then
            i=$((10#$answer))

            if (( i >= 1 && i <= count )); then
                printf '%s\n' "${options[i-1]}"
                return 0
            fi
        fi

        echo "Invalid option" >&2
    done
}

ask_text() {
    local prompt=$1 answer

    while true; do
        printf '%s: ' "$prompt" >&2
        IFS= read -r answer </dev/tty || return 2

        if [[ -n $answer ]]; then
            printf '%s\n' "$answer"
            return 0
        fi

        echo "Input cannot be empty" >&2
    done
}

USER_CONFIG="$HOME/.config"
USER_BIN="$HOME/.local/bin"
USER_SHARE="$HOME/.local/share"

CONFIG="$ROOT_DIR/config"
BIN="$ROOT_DIR/bin"
TMP="$ROOT_DIR/tmp"
SCRIPT="$ROOT_DIR/script"

mkdir -p -- \
    "$USER_CONFIG" \
    "$USER_BIN" \
    "$USER_SHARE" \
    "$CONFIG" \
    "$BIN" \
    "$TMP"

# Validate arguments
if (( $# < 1 )); then
    echo "Usage: $0 <script> [args...]"
    exit 1
fi

script=$1
shift

if [[ ! -f $script || ! -x $script ]]; then
    echo "Script not found or not executable: $script"
    exit 1
fi

(
    source "$script" "$@"
)

